# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.local
.env.*.local

# Databases & runtime local stores
*.db
*.sqlite
*.sqlite3

# Model checkpoints & large binary artifacts
models/saved/*.pkl
models/saved/*.joblib
!models/saved/.gitkeep
!data/.gitkeep

# IDEs & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing & logs
.pytest_cache/
.coverage
htmlcov/
*.log
